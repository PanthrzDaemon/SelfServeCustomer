APP_NAME=CloudFlow AI Support
ENVIRONMENT=development

# Ollama (runs outside the app container)
OLLAMA_HOST=http://localhost:11434
# Use the exact tag you pulled, e.g. qwen3:4b (see `ollama list`)
OLLAMA_MODEL=qwen3
EMBEDDING_MODEL=nomic-embed-text
# Qwen3 prompt mode: true = ChatML with an empty think block (faster), false = /api/chat
OLLAMA_RAW_CHATML=true
# false = never call the LLM; answers are composed extractively from sources
LLM_ENABLED=true

CHROMA_PATH=./chroma
DATABASE_PATH=./cloudflow.db

# Optional: extra LLM groundedness judge in the critic (slower)
CRITIC_LLM_JUDGE=false
# Optional: require X-Admin-Token on POST /ingest
ADMIN_TOKEN=

# Streamlit frontend -> API
API_URL=http://localhost:8000
